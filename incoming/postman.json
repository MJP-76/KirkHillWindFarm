{
  "info": {
    "_postman_id": "5ea1d9b0-91ec-4c8d-a16a-73a8b3a5d53f",
    "name": "Kirk Hill Wind Farm API",
    "description": "Read-only wind farm data API. Set the api_token collection variable to a dashboard-generated API key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://dashboard.kirkhillcoop.org",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "kh_live_replace_me",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Predicted CO2 avoided",
      "description": "Indicative CO2 savings for the rest of today and tomorrow. Check complete and coverage_percent before presenting a total as a full prediction. Uses predicted generation, forecast GB grid carbon intensity and the assumed export rate. Separate from historical CO2 figures.",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/carbon-avoided/forecast?scope=owner",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "carbon-avoided", "forecast"],
          "query": [{ "key": "scope", "value": "owner" }]
        }
      }
    },
    {
      "name": "Weather forecasts",
      "description": "Hourly wind, temperature and surface air-pressure predictions through tomorrow, shown separately for each weather model. Check status and complete for old or partial forecasts. Missing values are null. Weather values are the same for your share and the whole farm.",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/v1/weather-forecast?scope=site",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "weather-forecast"],
          "query": [{ "key": "scope", "value": "site" }]
        }
      }
    },
    {
      "name": "Generation and wind forecasts",
      "description": "Predicted generation and wind for the rest of today and tomorrow. Check status and complete for old or incomplete predictions. These are estimates, not guarantees or P50 expectations. Today's total covers only the remaining time.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/forecast?scope=owner",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "forecast"
          ],
          "query": [
            {
              "key": "scope",
              "value": "owner"
            }
          ]
        }
      }
    },
    {
      "name": "Detailed generation or wind history",
      "description": "Explore readings for a chosen turbine and time interval. Missing values are null, not zero. Generation estimated across gaps is marked as interpolated; wind averages include the number of readings used.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/series?range=mtd&metric=wind_speed_mps&resolution=1h&turbine=T4",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "series"
          ],
          "query": [
            {
              "key": "range",
              "value": "mtd"
            },
            {
              "key": "metric",
              "value": "wind_speed_mps"
            },
            {
              "key": "resolution",
              "value": "1h"
            },
            {
              "key": "turbine",
              "value": "T4"
            }
          ]
        }
      }
    },
    {
      "name": "Running generation totals",
      "description": "Running totals include known generation during gaps, with estimates identified. Unknown values remain null and totals stop at the last supported reading. Check complete before using a full-period total. The metric parameter is not accepted.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/generation/cumulative?range=last_month&resolution=day&scope=site",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "generation",
            "cumulative"
          ],
          "query": [
            {
              "key": "range",
              "value": "last_month"
            },
            {
              "key": "resolution",
              "value": "day"
            },
            {
              "key": "scope",
              "value": "site"
            }
          ]
        }
      }
    },
    {
      "name": "Daily and monthly statistics",
      "description": "Explore daily or monthly generation, wind, CO2 and performance. The current month is marked as month-to-date, with P50 expectations for the elapsed time. Missing figures include reasons; use the calendar to see missing or pending periods.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/statistics?period=month&order_by=date&direction=desc&page=1&per_page=25",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "statistics"
          ],
          "query": [
            {
              "key": "period",
              "value": "month"
            },
            {
              "key": "order_by",
              "value": "date"
            },
            {
              "key": "direction",
              "value": "desc"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "25"
            }
          ]
        }
      }
    },
    {
      "name": "Compare years",
      "description": "Compare monthly metrics across two or three years. Inspect is_complete for partial periods. Percentage metrics use percentage-point differences.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/statistics/compare?years[]=2025&years[]=2026&metric=generation_kwh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "statistics",
            "compare"
          ],
          "query": [
            {
              "key": "years[]",
              "value": "2025"
            },
            {
              "key": "years[]",
              "value": "2026"
            },
            {
              "key": "metric",
              "value": "generation_kwh"
            }
          ]
        }
      }
    },
    {
      "name": "Daily metric calendar",
      "description": "See a reading for each UK calendar day, with missing or incomplete days identified. Day lengths allow for the clocks changing.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/statistics/calendar?year=2026&metric=co2_avoided_kg",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "statistics",
            "calendar"
          ],
          "query": [
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "metric",
              "value": "co2_avoided_kg"
            }
          ]
        }
      }
    },
    {
      "name": "Record rankings",
      "description": "Explore top-three rankings, with dates and partial months identified. Monthly P50 records are judged against the whole month's target. Your share scales energy and CO2, not wind or percentages. Check coverage for CO2 estimates.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/records?scope=owner",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "records"
          ],
          "query": [
            {
              "key": "scope",
              "value": "owner"
            }
          ]
        }
      }
    },
    {
      "name": "P50, P75 and P90 benchmarks",
      "description": "Compare generation with long-term expectations, separately for your chosen period and the whole month. Includes expected capacity factors. Check completeness before comparing totals. These are not weather forecasts.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/benchmarks?range=mtd&scope=owner",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "benchmarks"
          ],
          "query": [
            {
              "key": "range",
              "value": "mtd"
            },
            {
              "key": "scope",
              "value": "owner"
            }
          ]
        }
      }
    },
    {
      "name": "Display preferences",
      "description": "Read your saved wind-speed unit (mps or mph). Available with any data permission and accepts no parameters. Wind readings remain in metres per second, so convert them for display if needed.",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/preferences",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "preferences"]
        }
      }
    },
    {
      "name": "Current readings",
      "description": "Latest current readings, including current power, today's generation in kWh and Wh, wind speed, turbine state, and capacity factor. Defaults to the API key holder's owner share.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/current",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "current"
          ]
        }
      }
    },
    {
      "name": "Current readings - site-wide",
